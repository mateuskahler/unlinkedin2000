{
  "manifest_version": 3,
  "name": "LinkedIn Feed Filter",
  "version": "1.0",
  "description": "Filter LinkedIn feed posts using a WebAssembly-based classifier (study project).",
  
  "permissions": [
    "offscreen"
  ],
  "background": {
    "service_worker": "web_classifier_amalgamation/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "resources": [
        "web_classifier_amalgamation/*"
      ],
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "utils.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}